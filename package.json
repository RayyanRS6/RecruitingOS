{
  "name": "recruiting-os",
  "private": true,
  "version": "0.1.0",
  "description": "A recruiting department for companies too small to have one.",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @ros/shell dev",
    "dev:api": "pnpm --filter @ros/api dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @ros/db generate",
    "db:migrate": "pnpm --filter @ros/db migrate",
    "db:seed": "pnpm --filter @ros/db seed",
    "eval": "pnpm --filter @ros/evals eval",
    "scenario": "vitest run tests/scenario",
    "e2e": "pnpm --filter @ros/e2e e2e",
    "db:validate": "pnpm --filter @ros/db validate",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "ci:local": "bash scripts/ci-local.sh",
    "db:provision": "pnpm --filter @ros/db provision",
    "db:status": "pnpm --filter @ros/db status",
    "worker:check": "pnpm --filter @ros/api typecheck",
    "worker:start": "pnpm --filter @ros/api worker"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
