{
  "name": "@ros/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "generate:custom": "drizzle-kit generate --custom",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "validate": "tsx src/cli/validate.ts",
    "provision": "tsx src/cli/provision.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@ros/contracts": "workspace:*",
    "@ros/playbooks": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "drizzle-kit": "latest",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
