# Copy to .env. These defaults run everything on one machine: PGlite, stand-in providers, the worker inside the app.
# Every variable, with what a hosted deployment needs, is in docs/14-deployment-and-environment.md.

NODE_ENV=development
# Which hosted deployment this is: "production" or "staging". Leave it unset on your own machine and in tests.
# DEPLOY_ENV=

# The one public address: the app, the API, the candidate pages and the webhooks are all served from it.
# Open the app at exactly this address: a change under /api posted from another origin is refused (cross_site).
APP_BASE_URL=http://localhost:3000
# A separate host for job pages, the form, the sitemap and the links in candidate emails. Defaults to APP_BASE_URL.
# JOBS_BASE_URL=
SESSION_SECRET=dev-only-change-me-32-bytes-minimum-please
# Salt for the analytics identifiers; a hosted deployment must set its own.
# ANALYTICS_SALT=
# How many proxies add to X-Forwarded-For (Vercel: 1). Only that entry is trusted as the client's address.
# TRUST_PROXY_HOPS=1
# Production refuses this: its session cookie stays host-only.
# COOKIE_DOMAIN=
# Set by the code or by apps/shell/next.config.ts; only needed when a bundler hides the workspace root.
# ROS_REPO_ROOT=
# ROS_MIGRATIONS_DIR=

# Database: leave DATABASE_URL unset to use PGlite (Postgres in WebAssembly) at PGLITE_DIR.
PGLITE_DIR=./.data/pglite
# DATABASE_URL=postgres://ros_app:pass@host:5432/recruiting_os          # the app's role, never a superuser
# WORKER_DATABASE_URL=postgres://ros_worker:pass@host:5432/recruiting_os # the worker's role
# MIGRATE_DATABASE_URL=postgres://owner:pass@host:5432/recruiting_os    # the owner role: pnpm db:migrate, db:seed, db:status
# The database tools need the database named: staging or production, and for production its Supabase project reference.
# ROS_DB_ENV=
# ROS_DB_PROJECT_REF=
# Supabase's certificate authority: the text on a host, a file path on your own machine. Production refuses to start without one.
# DATABASE_SSL_CA=
# DATABASE_SSL_CA_FILE=
# Connections per process (on Vercel, per instance).
# DATABASE_POOL_MAX=3
# A hosted process never migrates by itself; migrations are a release step.
# RUN_MIGRATIONS_ON_BOOT=false
# Runs the isolation and privacy tests against a real, empty Postgres instead of PGlite.
# TEST_DATABASE_URL=

# Sign-in: "supabase" on a hosted deployment (Google and Microsoft through Supabase Auth), "fake" here.
AUTH_PROVIDER=fake
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_JWT_SECRET=
# The providers the sign-in page offers, and the only ones a session opens through.
# AUTH_SIGNIN_PROVIDERS=azure,google
# People on these domains are platform staff: Microsoft sign-in and a second factor.
# ITS_STAFF_EMAIL_DOMAINS=
# Once only: the address that becomes the first platform administrator (docs/runbooks/production-setup.md, "First administrator").
# BOOTSTRAP_ADMIN_EMAILS=
# The email sign-in link, a development aid. Production refuses it on.
MAGIC_LINK_ENABLED=true
# How a company comes in. Unset or "open" (here and in tests): a company is live the moment it is created.
# "approval" (the only value a hosted app starts with): the company form sends a request, and nothing of the company
# works or is public until a platform administrator accepts it. Any other value stops the app at start.
# SIGNUP_MODE=approval

# AI. "fake" is a deterministic stand-in that a hosted deployment refuses.
AI_PROVIDER=fake
# ANTHROPIC_API_KEY=
# Only claude-haiku-5-5 and claude-sonnet-5-5 are allowed (packages/ai/src/routing.ts); any other value stops the app.
# AI_MODEL_JUDGMENT=claude-sonnet-5-5
# AI_MODEL_STANDARD=claude-haiku-5-5
# AI_MODEL_FAST=claude-haiku-5-5
# How hard a tier thinks (low, medium, high); unset is the app's own setting. The fairness run sets one to compare.
# AI_EFFORT_JUDGMENT=
# AI_EFFORT_STANDARD=
# AI_EFFORT_FAST=

# Email. "fake" sends nothing; /dev/outbox lists what it would have sent.
EMAIL_PROVIDER=fake
# POSTMARK_SERVER_TOKEN=
# Made up with scripts/new-secret.ps1; production refuses it under 32 characters.
# POSTMARK_WEBHOOK_SECRET=
EMAIL_FROM_DOMAIN=mail.localhost
# The one sending address; defaults to updates@<EMAIL_FROM_DOMAIN>.
# EMAIL_FROM_ADDRESS=
# Where candidate replies land, and the contact printed on job pages for a company that set none; defaults to ITS_QUEUE_EMAIL.
# EMAIL_REPLY_TO=
# The platform's own mailbox: requests for access and changes of administrators.
# ITS_QUEUE_EMAIL=
# The privacy mailbox shown to candidates.
# PRIVACY_EMAIL=
PRODUCT_NAME=Recruiting OS
# Seconds a decision email waits before it leaves, so a person can take it back (0 to 120).
# MESSAGE_UNDO_SECONDS=30

# Files: memory (tests), local (files under STORAGE_DIR), supabase (a hosted deployment; docs/runbooks/resume-storage.md).
STORAGE_PROVIDER=local
STORAGE_DIR=./.data/files
# STORAGE_BUCKET=resumes
# STORAGE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# STORAGE_S3_REGION=us-west-2
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# Malware scanning: "fake" checks a file's type only; "clamav" on the worker (docs/runbooks/resume-storage.md, "Running ClamAV on Railway").
SCAN_PROVIDER=fake
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=20000

# Rate limits: "memory" counts in one process; "upstash" shares one count (a hosted app); "fake" is for tests.
RATE_LIMIT_STORE=memory
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Limits per policy as JSON, for tests; production refuses it.
# RATE_LIMIT_OVERRIDES=

# The content-security policy: "report-only" or "enforce".
CSP_MODE=report-only

# Analytics: server-side events only, never from candidate pages. "fake" sends none.
ANALYTICS_PROVIDER=fake
# POSTHOG_PROJECT_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Error reports, scrubbed. Off without a DSN.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_TRACES_SAMPLE_RATE=0
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# The worker. On a hosted deployment it is a process of its own (pnpm worker:start).
WORKER_INLINE=true
WORKER_POLL_MS=500
# The worker exits when nothing has finished for this long, so its host restarts it; at least 60000.
# WORKER_STALL_EXIT_MS=900000
# The worker's health-check port; Railway sets it.
# PORT=8080
