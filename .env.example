# Copy to .env. Every variable is documented in docs/14-deployment-and-environment.md.

NODE_ENV=development

# Database: leave DATABASE_URL unset to use PGlite (Postgres in WebAssembly) at PGLITE_DIR.
# DATABASE_URL=postgres://ros_app:pass@host:5432/recruiting_os          # the API's non-privileged role (migrations/0003)
# WORKER_DATABASE_URL=postgres://ros_worker:pass@host:5432/recruiting_os # the worker's role; required in production
# MIGRATE_DATABASE_URL=postgres://owner:pass@host:5432/recruiting_os    # owner role used only by `pnpm db:migrate` (a release step)
# RUN_MIGRATIONS_ON_BOOT=false   # production never migrates on boot
# ROS_MIGRATIONS_DIR=            # set by apps/shell/next.config.ts; only needed when a bundler hides packages/db/migrations
PGLITE_DIR=./.data/pglite

# The one public address: the app, the API, candidate pages and webhooks are all served from it. Production requires https.
APP_BASE_URL=http://localhost:3000
# The public job-page host (job pages, apply pages, careers pages, feeds, sitemap, posting packages, tracked links).
# Defaults to APP_BASE_URL; set to https://jobs.identifiedtalent.com once that domain is attached to the deployment.
# JOBS_BASE_URL=
SESSION_SECRET=dev-only-change-me-32-bytes-minimum-please
# How many proxies append to X-Forwarded-For (Vercel: 1). Only that entry is trusted as the client address.
# TRUST_PROXY_HOPS=1
# Relative data paths resolve against the repository root; set this only when a bundler hides where that is.
# ROS_REPO_ROOT=
# Sign-in (D19): "supabase" in production (Google and Microsoft configured in Supabase Auth; PKCE; tokens verified here), "fake" elsewhere (an in-process issuer).
AUTH_PROVIDER=fake
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=            # public key used only to call the token endpoint
# SUPABASE_JWT_SECRET=          # optional: verifies HS256 tokens; otherwise the project's published keys are used
# AUTH_SIGNIN_PROVIDERS=azure,google
# Users on these domains are ITS staff: Microsoft sign-in and a second factor are required.
ITS_STAFF_EMAIL_DOMAINS=identifiedtalent.com
# One-time bootstrap only: the FIRST platform administrator, granted on that address's first Microsoft sign-in with a second
# factor while no administrator exists. Afterwards the list grants nothing (audited as ignored): remove it. Every later
# administrator is granted in the console by an existing administrator. See docs/readiness/13-administrator-bootstrap.md.
# BOOTSTRAP_ADMIN_EMAILS=first-administrator@your-staff-domain.example
# The internal email link stays available in development; production defaults to off.
MAGIC_LINK_ENABLED=true
# Set when the API and the web app are on different hosts of one site, e.g. .example.com (cookies ignore ports, so localhost needs nothing)
# COOKIE_DOMAIN=
# Secrets (OAuth tokens, integration credentials) live in a managed key-management service: "vault" (Supabase Vault) in production, "memory" in development.
SECRET_STORE=memory

# AI. "fake" is deterministic and never allowed in production.
AI_PROVIDER=fake
# ANTHROPIC_API_KEY=
# AI_MODEL_JUDGMENT=claude-opus-5
# AI_MODEL_STANDARD=claude-sonnet-5
# AI_MODEL_FAST=claude-haiku-4-5

# Email. "fake" records messages in the database and exposes magic links in dev.
EMAIL_PROVIDER=fake
# POSTMARK_SERVER_TOKEN=
# Inbound webhook secret. With EMAIL_PROVIDER=postmark and an EMAIL_INTAKE_DOMAIN that does not end in "localhost" (its MX
# record pointing at Postmark), this switches on email-in applications and candidate replies (docs/runbooks/candidate-replies.md).
# POSTMARK_INBOUND_SECRET=
# POSTMARK_WEBHOOK_SECRET=   # bounce, spam-complaint and delivery webhooks (basic auth on the webhook URL or the x-webhook-secret header)
EMAIL_FROM_DOMAIN=mail.localhost
# Production: updates@hire.identifiedtalent.com (a dedicated ITS subdomain with SPF, DKIM, DMARC); display names name the customer's hiring team.
# EMAIL_FROM_ADDRESS=updates@hire.identifiedtalent.com
# Where candidate replies land while the inbound mail domain is not configured: a monitored ITS mailbox (defaults to
# ITS_QUEUE_EMAIL). Once it is configured, every candidate email carries its own reply-<token>@<EMAIL_INTAKE_DOMAIN> address
# and replies come back into the product instead.
# EMAIL_REPLY_TO=
PRODUCT_NAME=Recruiting OS
# The dedicated privacy-request address shown to candidates (a monitored ITS shared mailbox).
PRIVACY_EMAIL=privacy@identifiedtalent.com
# The ITS queue mailbox: recruiter requests, every administrator change, every ended access (founder decision, gate 1.5 of docs/readiness/16).
# Falls back to recruiters@its.localhost when unset, which is only right on a laptop.
# ITS_QUEUE_EMAIL=recruiting-replies@identifiedtalent.com

# Product analytics: server-side funnel events only, keyed by salted hashes; never on candidate pages, never PII.
ANALYTICS_PROVIDER=fake
# POSTHOG_PROJECT_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# ANALYTICS_SALT=   # per environment; never reused across staging and production; required in production
# Per-role intake addresses and per-application reply addresses. While it ends in "localhost", email-in shows as not
# connected and replies go to EMAIL_REPLY_TO.
EMAIL_INTAKE_DOMAIN=intake.localhost

# SMS. "fake" records texts (see /dev/sms-outbox). "twilio" needs the three values below (or TWILIO_FROM_NUMBER) and an approved A2P 10DLC campaign.
# Texting candidates stays off (SMS_ENABLED=false) until counsel, carrier registration and a partner need it; it defaults to on only with twilio.
SMS_PROVIDER=fake
# SMS_ENABLED=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM_NUMBER=
# TWILIO_WEBHOOK_URL=   # the exact public URL Twilio posts to, when it differs from APP_BASE_URL/webhooks/twilio/inbound

# Calendars (D2, correction 3): "google" needs the OAuth client from the ITS Google Cloud project (docs/spec/13 §8); anything else uses the fake provider.
CALENDAR_PROVIDER=fake
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Job boards: Indeed, ZipRecruiter and LinkedIn are manual in release 1 (the customer posts from their own account and
# points the board at the apply link). No board credential is read until a partner integration is verified.
# A posting is called live only after its public URL was fetched and named the job: production really fetches; elsewhere
# the check is a scripted fake unless LINK_VERIFIER=real.
# LINK_VERIFIER=fake

# Compensation data: the BLS wage benchmark is called live unless COMP_BLS_ENABLED=false (tests and offline work).
# BLS_API_KEY=
# COMP_BLS_ENABLED=true

# Résumé storage (decision 2, 22 Sep 2026): memory (tests), local (development), supabase (staging and production;
# required in production). With supabase, every STORAGE_S3_* value comes from the dashboard's Storage → S3 Configuration
# screen and the bucket is private; see docs/runbooks/resume-storage.md.
# TLS trust for Postgres (22 Sep): Supabase signs its certificates with its own authority. Give it as text in a hosted
# environment (DATABASE_SSL_CA) or as a file path on a person's machine (DATABASE_SSL_CA_FILE). Verification is never off.
# DATABASE_SSL_CA=
# DATABASE_SSL_CA_FILE=
# DATABASE_POOL_MAX=5                 # connections per process on the Session pooler
STORAGE_PROVIDER=local
STORAGE_DIR=./.data/files
# STORAGE_BUCKET=resumes
# STORAGE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# STORAGE_S3_REGION=us-west-2
# STORAGE_S3_ACCESS_KEY_ID=          # entered by the founder; treat as sensitive
# STORAGE_S3_SECRET_ACCESS_KEY=      # entered by the founder; sensitive, sealed
# Malware scanning of quarantined uploads: "fake" (development, tests, and the app, which never scans) or "clamav" on the
# worker (a clamd service reached over private networking; docs/runbooks/resume-storage.md, "Running ClamAV on Railway").
# A production worker on "fake" raises a standing alert: a real engine is a real-data gate (docs/readiness/20 blocker 8).
SCAN_PROVIDER=fake
# CLAMAV_HOST=clamav.railway.internal   # SCAN_PROVIDER=clamav: the clamd service's private hostname (the worker only)
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=20000

WORKER_INLINE=true   # development only; production refuses it (the worker is a separate process)
WORKER_POLL_MS=500
# PORT=8080          # the worker's health-check port (GET /healthz answers 200 while it polls, 503 once stale); Railway sets it

# Rate limiting (21 Sep, item 5; docs/readiness/15): "memory" counts per process; "upstash" shares counters between every
# API process (staging and production); "fake" is an in-process stand-in for the shared store, for tests only.
RATE_LIMIT_STORE=memory
# UPSTASH_REDIS_REST_URL=       # RATE_LIMIT_STORE=upstash: the database's REST endpoint (not a secret)
# UPSTASH_REDIS_REST_TOKEN=     # secret: entered at the host, never in a file or chat; degrades to per-process counting if unreachable
# Per-policy limit overrides as JSON, for rehearsals only, e.g. {"api.user":50}
# RATE_LIMIT_OVERRIDES=

# Content-security policy (21 Sep, item 6; docs/readiness/18). Stays "report-only" until the staging reports are reviewed.
CSP_MODE=report-only

# The one-time ITS check of a self-serve company (founder decision B7). Unset, it is "its" (the default, and the only value
# production accepts: it refuses to start with "auto"): a new company's public pages and first candidate emails wait until
# an administrator confirms it in /admin. "auto" confirms every new company at sign-up, which is the convenient value on
# your own machine: a company you create locally goes live at once instead of waiting for /admin. Staging and production
# leave it unset.
COMPANY_CHECK=auto

# Error reporting (decision 3, 22 Sep 2026): the official Sentry SDK, scrubbed, no replay. Empty DSN = off.
# SENTRY_DSN=                   # server processes (Vercel, Railway); the DSN is not a secret but is entered by the founder
# NEXT_PUBLIC_SENTRY_DSN=       # optional: the owner/recruiter/admin web app only; candidate pages carry no script
# SENTRY_ENVIRONMENT=staging     # names the environment on reports; "staging" also enables the administrators' scrubbing-proof route (docs/14)
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging   # the environment name on the browser bundle's reports; defaults to "development"
# SENTRY_TRACES_SAMPLE_RATE=0
